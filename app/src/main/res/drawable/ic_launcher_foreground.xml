<?xml version="1.0" encoding="utf-8"?>
<!-- TapGem: a faceted gem in the Siri palette (indigo → violet → pink → orange → sky). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- soft glow -->
    <path android:pathData="M54,22 L84,44 L54,88 L24,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="52" android:gradientRadius="40">
                <item android:offset="0" android:color="#66BF5AF2"/>
                <item android:offset="1" android:color="#00BF5AF2"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- crown (top facets) -->
    <path android:pathData="M38,30 L70,30 L82,44 L26,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="26" android:startY="30" android:endX="82" android:endY="44">
                <item android:offset="0" android:color="#FF64D2FF"/>
                <item android:offset="0.5" android:color="#FF5E5CE6"/>
                <item android:offset="1" android:color="#FFBF5AF2"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M38,30 L48,44 L26,44 Z" android:fillColor="#33FFFFFF"/>
    <path android:pathData="M70,30 L82,44 L60,44 Z" android:fillColor="#22000000"/>
    <path android:pathData="M48,44 L54,30 L60,44 Z" android:fillColor="#40FFFFFF"/>

    <!-- pavilion (bottom facets) -->
    <path android:pathData="M26,44 L82,44 L54,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="26" android:startY="44" android:endX="70" android:endY="82">
                <item android:offset="0" android:color="#FFBF5AF2"/>
                <item android:offset="0.55" android:color="#FFFF375F"/>
                <item android:offset="1" android:color="#FFFF9F0A"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M26,44 L48,44 L54,82 Z" android:fillColor="#2AFFFFFF"/>
    <path android:pathData="M60,44 L82,44 L54,82 Z" android:fillColor="#26000000"/>

    <!-- outline -->
    <path android:pathData="M38,30 L70,30 L82,44 L54,82 L26,44 Z M26,44 L82,44 M48,44 L54,30 L60,44 M48,44 L54,82 L60,44"
        android:strokeColor="#CCFFFFFF" android:strokeWidth="1.4" android:fillColor="#00000000"
        android:strokeLineJoin="round"/>

    <!-- tap ripple -->
    <path android:pathData="M54,54 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" android:fillColor="#FFFFFFFF"/>
    <path android:pathData="M54,54 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:strokeColor="#99FFFFFF" android:strokeWidth="1.2" android:fillColor="#00000000"/>
</vector>
